# Postgres (native install, not Docker). NOTE: async scheme (asyncpg) — required.
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/billing

# Stripe test mode — never use live keys. .env is gitignored.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_FREE_ID=price_replace_me
STRIPE_PRICE_PRO_ID=price_replace_me

# Celery broker/backend (Redis) — one URL works for both
REDIS_URL=redis://localhost:6379/0

# App
BASE_URL=http://localhost:8000
DEBUG=false
